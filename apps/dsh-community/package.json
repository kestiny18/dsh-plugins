{
  "name": "dsh-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "release:check": "pnpm run check && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply dsh-community --local",
    "db:migrate:remote": "wrangler d1 migrations apply dsh-community --remote",
    "deploy": "pnpm run check && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "vite": "^7.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.31.0"
  }
}
