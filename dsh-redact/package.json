{
  "name": "dsh-redact",
  "version": "0.1.0",
  "description": "Fail-closed canonical tool-output tokenization for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11 <12"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./redaction": {
      "types": "./lib/redaction.d.ts",
      "default": "./lib/redaction.js"
    },
    "./vault": {
      "types": "./lib/vault.d.ts",
      "default": "./lib/vault.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "node scripts/verify-release.mjs && pnpm run check && pnpm run pack:check",
    "release:publish": "pnpm run release:check && npm publish",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "redaction",
    "secrets",
    "llm-security"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kestiny18/dsh-plugins.git",
    "directory": "dsh-redact"
  },
  "homepage": "https://github.com/kestiny18/dsh-plugins/tree/main/dsh-redact#readme",
  "bugs": {
    "url": "https://github.com/kestiny18/dsh-plugins/issues"
  }
}
